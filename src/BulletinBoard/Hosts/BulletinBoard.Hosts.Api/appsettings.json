{
  "ConnectionStrings": {
    "MainDb": "Host=localhost;Port=5432;Database=bulletin_board;Username=postgres;Password=password",
    "Redis": "localhost:6379"
  },

  "Caching": {
    "EnableRedis": true,
    "AdvertisementDetailMinutes": 5,
    "CategoryListMinutes": 60,
    "MemoryCacheRatio": 0.3,
    "MemoryRehydrationMinutes": 1.5
  },
  
  "Jwt": {
    "Secret": "z$L&tF8^%k@J#p!2s5v8y/B?E(G+KbNcQeThVmYq3t6w9z$C&F)J@M-g2k4m7p!r",
    "Issuer": "BulletinBoard",
    "Audience": "BulletinBoard",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "BulletinBoard.Infrastructure.Services.HybridCacheService": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/bulletinboard-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  
  "AllowedHosts": "*"
}
